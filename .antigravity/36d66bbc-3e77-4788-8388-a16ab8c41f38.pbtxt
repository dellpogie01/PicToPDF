alTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)\n            }\n          }\n          Spacer(modifier = Modifier.height(4.dp))\n          Text(\n            text = \"Pic To PDF is a native Android document scanner and PDF creator. All images and PDF files are processed entirely offline and locally on your device.\",\n            style = MaterialTheme.typography.bodyMedium,\n            color = MaterialTheme.colorScheme.onSurfaceVariant\n          )\n        }\n      }\n\n      // Privacy Notice Section\n      Text(\"Privacy & Security\", style = MaterialTheme.typography.titleMedium, color = MaterialTheme.colorScheme.primary, fontWeight = FontWeight.Bold)\n      Card(\n        modifier = Modifier.fillMaxWidth()\n      ) {\n        Column(modifier = Modifier.padding(16.dp)) {\n          Text(\n            text = \"Pic To PDF processes your images and creates PDF documents locally on your device. Your documents are not uploaded to any remote server. No account or cloud database is required.\",\n            style = MaterialTheme.typography.bodyMedium\n          )\n        }\n      }\n\n      // Permissions Info\n      Text(\"App Permissions\", style = MaterialTheme.typography.titleMedium, color = MaterialTheme.colorScheme.primary, fontWeight = FontWeight.Bold)\n      Card(\n        modifier = Modifier.fillMaxWidth()\n      ) {\n        Column(\n          modifier = Modifier.padding(16.dp),\n          verticalArrangement = Arrangement.spacedBy(8.dp)\n        ) {\n          Row(verticalAlignment = Alignment.CenterVertically) {\n            Icon(Icons.Default.CameraAlt, contentDescription = null, tint = MaterialTheme.colorScheme.secondary)\n            Spacer(modifier = Modifier.width(12.dp))\n            Text(\"Camera: Used only to capture document scans.\", style = MaterialTheme.typography.bodyMedium)\n          }\n          Row(verticalAlignment = Alignment.CenterVertically) {\n            Icon(Icons.Default.Folder, contentDescription = null, tint = MaterialTheme.colorScheme.secondary)\n            Spacer(modifier = Modifier.width(12.dp))\n            Text(\"Storage Access: Used via SAF to save PDFs locally.\", style = MaterialTheme.typography.bodyMedium)\n          }\n        }\n      }\n    }\n  }\n}\n"
